{
  "name": "sulo-schema-builder-api",
  "version": "0.1.1",
  "description": "SULO-Compliant Schema Builder REST API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate:dist": "node dist/scripts/migrate.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/static": "^10.1.3",
    "@sulo/schema-core": "*",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.0.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "kysely": "^0.29.5",
    "n3": "^1.17.0",
    "pg": "^8.23.0",
    "undici": "^8.10.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/n3": "^1.16.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@yao-pkg/pkg": "^6.22.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "resources/db-schema.sql",
      "resources/sulo.ttl",
      "node_modules/better-sqlite3/build/Release/*.node",
      "node_modules/better-sqlite3/prebuilds/**/*"
    ],
    "targets": [
      "node22-macos-arm64",
      "node22-macos-x64",
      "node22-linux-x64",
      "node22-win-x64"
    ],
    "outputPath": "pkg-dist"
  }
}
