  "productName": "SULO Schema Builder",
  "version": "0.1.1",
  "identifier": "org.maastrichtu-ids.sulo-schema-builder",
  "build": {
    "frontendDist": "dist-placeholder"
  },
  "app": {
    "windows": [],
