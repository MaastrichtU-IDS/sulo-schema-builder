# ── Domain / Range class expressions (OWL equivalent axioms) ──────────────

<https://w3id.org/sulo/schema-builder/omop-cdm-schema/Concept_concept_id_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Concept [ a owl:Restriction ; owl:onProperty sulo:hasValue ; owl:someValuesFrom xsd:integer ] ) ] .

<https://w3id.org/sulo/schema-builder/omop-cdm-schema/Concept_concept_name_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Concept [ a owl:Restriction ; owl:onProperty sulo:hasLabel ; owl:someValuesFrom xsd:string ] ) ] .

<https://w3id.org/sulo/schema-builder/omop-cdm-schema/VisitOccurrence_person_id_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :VisitOccurrence [ a owl:Restriction ; owl:onProperty sulo:hasParticipant ; owl:someValuesFrom [ a owl:Class ; owl:intersectionOf ( :PatientRole [ a owl:Restriction ; owl:onProperty sulo:isFeatureOf ; owl:someValuesFrom :Person ] ) ] ] ) ] .

<https://w3id.org/sulo/schema-builder/omop-cdm-schema/VisitOccurrence_person_id_range>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Person [ a owl:Restriction ; owl:onProperty [ owl:inverseOf sulo:isFeatureOf ] ; owl:someValuesFrom [ a owl:Class ; owl:intersectionOf ( :PatientRole [ a owl:Restriction ; owl:onProperty [ owl:inverseOf sulo:hasParticipant ] ; owl:someValuesFrom :VisitOccurrence ] ) ] ] ) ] .

<https://w3id.org/sulo/schema-builder/omop-cdm-schema/VisitOccurrence_provider_id_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :VisitOccurrence [ a owl:Restriction ; owl:onProperty sulo:hasParticipant ; owl:someValuesFrom [ a owl:Class ; owl:intersectionOf ( :ProviderRole [ a owl:Restriction ; owl:onProperty sulo:isFeatureOf ; owl:someValuesFrom :Provider ] ) ] ] ) ] .

<https://w3id.org/sulo/schema-builder/omop-cdm-schema/VisitOccurrence_provider_id_range>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Provider [ a owl:Restriction ; owl:onProperty [ owl:inverseOf sulo:isFeatureOf ] ; owl:someValuesFrom [ a owl:Class ; owl:intersectionOf ( :ProviderRole [ a owl:Restriction ; owl:onProperty [ owl:inverseOf sulo:hasParticipant ] ; owl:someValuesFrom :VisitOccurrence ] ) ] ] ) ] .

<https://w3id.org/sulo/schema-builder/omop-cdm-schema/VisitOccurrence_care_site_id_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :VisitOccurrence [ a owl:Restriction ; owl:onProperty sulo:isIn ; owl:someValuesFrom :CareSite ] ) ] .

<https://w3id.org/sulo/schema-builder/omop-cdm-schema/VisitOccurrence_care_site_id_range>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :CareSite [ a owl:Restriction ; owl:onProperty [ owl:inverseOf sulo:isIn ] ; owl:someValuesFrom :VisitOccurrence ] ) ] .

<https://w3id.org/sulo/schema-builder/omop-cdm-schema/VisitOccurrence_visit_concept_id_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :VisitOccurrence [ a owl:Restriction ; owl:onProperty sulo:hasFeature ; owl:someValuesFrom :Concept ] ) ] .

<https://w3id.org/sulo/schema-builder/omop-cdm-schema/VisitOccurrence_visit_concept_id_range>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Concept [ a owl:Restriction ; owl:onProperty [ owl:inverseOf sulo:hasFeature ] ; owl:someValuesFrom :VisitOccurrence ] ) ] .

<https://w3id.org/sulo/schema-builder/omop-cdm-schema/VisitOccurrence_visit_start_datetime_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :VisitOccurrence [ a owl:Restriction ; owl:onProperty sulo:atTime ; owl:someValuesFrom [ a owl:Class ; owl:intersectionOf ( sulo:StartTime [ a owl:Restriction ; owl:onProperty sulo:hasValue ; owl:someValuesFrom xsd:dateTime ] ) ] ] ) ] .

<https://w3id.org/sulo/schema-builder/omop-cdm-schema/VisitOccurrence_visit_end_datetime_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :VisitOccurrence [ a owl:Restriction ; owl:onProperty sulo:atTime ; owl:someValuesFrom [ a owl:Class ; owl:intersectionOf ( sulo:EndTime [ a owl:Restriction ; owl:onProperty sulo:hasValue ; owl:someValuesFrom xsd:dateTime ] ) ] ] ) ] .

