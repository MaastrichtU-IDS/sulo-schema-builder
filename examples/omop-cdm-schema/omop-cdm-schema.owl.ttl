    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :VisitOccurrence [ a owl:Restriction ; owl:onProperty [ owl:inverseOf sulo:isPartOf ] ; owl:someValuesFrom :VisitOccurrence ] ) ] .

