@prefix : <https://w3id.org/sulo/schema-builder/omop-cdm-schema/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix sulo: <https://w3id.org/sulo/> .

<https://w3id.org/sulo/schema-builder/omop-cdm-schema>
    a owl:Ontology ;
    dct:title "OMOP CDM Schema" ;
    dct:description "OMOP Common Data Model schema with core clinical tables (VisitOccurrence, ConditionOccurrence, DrugExposure, Measurement, ProcedureOccurrence, Observation, DeviceExposure) mapped to SULO. Intentionally contains SULO domain/range violations (see docs/omop-consistency-issues.md and docs/omop-modeling-error-examples.md) — HermiT reports 44 unsatisfiable classes." ;
    owl:imports <https://w3id.org/sulo/> .

# ── Classes ──────────────────────────────────────────────────────────────

:VisitOccurrence
    a owl:Class ;
    rdfs:label "Visit Occurrence" ;
    rdfs:comment "A healthcare encounter between a person and the healthcare system." ;
    rdfs:subClassOf sulo:Process .

:ConditionOccurrence
    a owl:Class ;
    rdfs:label "Condition Occurrence" ;
    rdfs:comment "A record of a disease, injury, or medical condition observed in a person." ;
    rdfs:subClassOf sulo:Process .

:DrugExposure
    a owl:Class ;
    rdfs:label "Drug Exposure" ;
    rdfs:comment "A record of a drug or vaccine administered to or ingested by a person." ;
    rdfs:subClassOf sulo:Process .

:Measurement
    a owl:Class ;
    rdfs:label "Measurement" ;
    rdfs:comment "A structured result obtained through systematic examination or testing (lab, vital signs)." ;
    rdfs:subClassOf sulo:InformationObject .

:ProcedureOccurrence
    a owl:Class ;
    rdfs:label "Procedure Occurrence" ;
    rdfs:comment "A record of an activity or process ordered or carried out on a person." ;
    rdfs:subClassOf sulo:Process .

:Observation
    a owl:Class ;
    rdfs:label "Observation" ;
    rdfs:comment "A clinical fact about a person not captured in other tables (e.g. smoking status, BMI)." ;
    rdfs:subClassOf sulo:InformationObject .

:DeviceExposure
    a owl:Class ;
    rdfs:label "Device Exposure" ;
    rdfs:comment "Exposure to a foreign physical object used for diagnostic or therapeutic purposes." ;
    rdfs:subClassOf sulo:Process .

:Person
    a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A person who is the subject of health-related data." ;
    rdfs:subClassOf sulo:SpatialObject .

:Provider
    a owl:Class ;
    rdfs:label "Provider" ;
    rdfs:comment "A healthcare provider (clinician, nurse, etc.) who delivers care." ;
    rdfs:subClassOf sulo:SpatialObject .

:CareSite
    a owl:Class ;
    rdfs:label "Care Site" ;
    rdfs:comment "A uniquely identified healthcare delivery location or organisational unit." ;
    rdfs:subClassOf sulo:SpatialObject .

:Location
    a owl:Class ;
    rdfs:label "Location" ;
    rdfs:comment "A physical or geographic address associated with a care site or person." ;
    rdfs:subClassOf sulo:SpatialObject .

:Concept
    a owl:Class ;
    rdfs:label "Concept" ;
    rdfs:comment "A standardised vocabulary concept (SNOMED-CT, RxNorm, LOINC, etc.) used to express clinical data." ;
    rdfs:subClassOf sulo:InformationObject .

:DrugProduct
    a owl:Class ;
    rdfs:label "Drug Product" ;
    rdfs:comment "A pharmaceutical substance or drug formulation identified by a vocabulary concept." ;
    rdfs:subClassOf sulo:SpatialObject .

:Device
    a owl:Class ;
    rdfs:label "Device" ;
    rdfs:comment "A medical device or instrument used in diagnosis or therapy." ;
    rdfs:subClassOf sulo:SpatialObject .

:Specimen
    a owl:Class ;
    rdfs:label "Specimen" ;
    rdfs:comment "A biological specimen collected from a person for laboratory analysis." ;
    rdfs:subClassOf sulo:SpatialObject .

:PatientRole
    a owl:Class ;
    rdfs:label "Patient Role" ;
    rdfs:comment "The role played by a person as the subject of a clinical event." ;
    rdfs:subClassOf sulo:Role .

:ProviderRole
    a owl:Class ;
    rdfs:label "Provider Role" ;
    rdfs:comment "The role played by a provider who participates in a clinical event." ;
    rdfs:subClassOf sulo:Role .

:OutputRole
    a owl:Class ;
    rdfs:label "Output Role" ;
    rdfs:comment "The role of an entity produced as an output of a clinical process." ;
    rdfs:subClassOf sulo:Role .

:InstrumentRole
    a owl:Class ;
    rdfs:label "Instrument Role" ;
    rdfs:comment "The role of a device or instrument used in a clinical process." ;
    rdfs:subClassOf sulo:Role .

:MeasurementValue
    a owl:Class ;
    rdfs:label "Measurement Value" ;
    rdfs:comment "A numerical or categorical value obtained from a measurement." ;
    rdfs:subClassOf sulo:Quantity .

:Unit
    a owl:Class ;
    rdfs:label "Unit" ;
    rdfs:comment "A unit of measure associated with a measurement or dose." ;
    rdfs:subClassOf sulo:Quality .

:DoseQuantity
    a owl:Class ;
    rdfs:label "Dose Quantity" ;
    rdfs:comment "The quantity of a drug dispensed or administered." ;
    rdfs:subClassOf sulo:Quantity .

# ── Properties ───────────────────────────────────────────────────────────

:concept_id
    a owl:DatatypeProperty ;
    rdfs:label "Concept ID" ;
    rdfs:comment "The unique integer identifier of the concept in the vocabulary." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/Concept_concept_id_domain> ;
    rdfs:range xsd:integer .

:concept_name
    a owl:DatatypeProperty ;
    rdfs:label "Concept Name" ;
    rdfs:comment "The human-readable name or label of the concept." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/Concept_concept_name_domain> ;
    rdfs:range xsd:string .

:person_id
    a owl:ObjectProperty ;
    rdfs:label "Person ID" ;
    rdfs:comment "Links a visit occurrence to the patient (subject of care)." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/VisitOccurrence_person_id_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/omop-cdm-schema/VisitOccurrence_person_id_range> .

:provider_id
    a owl:ObjectProperty ;
    rdfs:label "Provider ID" ;
    rdfs:comment "Links a visit occurrence to the attending healthcare provider." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/VisitOccurrence_provider_id_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/omop-cdm-schema/VisitOccurrence_provider_id_range> .

:care_site_id
    a owl:ObjectProperty ;
    rdfs:label "Care Site ID" ;
    rdfs:comment "Links a visit occurrence to the care site where it took place." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/VisitOccurrence_care_site_id_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/omop-cdm-schema/VisitOccurrence_care_site_id_range> .

:visit_concept_id
    a owl:ObjectProperty ;
    rdfs:label "Visit Concept ID" ;
    rdfs:comment "Links a visit occurrence to its standardised vocabulary concept (visit type)." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/VisitOccurrence_visit_concept_id_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/omop-cdm-schema/VisitOccurrence_visit_concept_id_range> .

:visit_start_datetime
    a owl:DatatypeProperty ;
    rdfs:label "Visit Start Datetime" ;
    rdfs:comment "Date and time when the visit started." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/VisitOccurrence_visit_start_datetime_domain> ;
    rdfs:range xsd:dateTime .

:visit_end_datetime
    a owl:DatatypeProperty ;
    rdfs:label "Visit End Datetime" ;
    rdfs:comment "Date and time when the visit ended." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/VisitOccurrence_visit_end_datetime_domain> ;
    rdfs:range xsd:dateTime .

:admitting_source_concept_id
    a owl:ObjectProperty ;
    rdfs:label "Admitting Source Concept ID" ;
    rdfs:comment "Concept for the place of service or type of provider from which the patient was admitted." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/VisitOccurrence_admitting_source_concept_id_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/omop-cdm-schema/VisitOccurrence_admitting_source_concept_id_range> .

:discharge_to_concept_id
    a owl:ObjectProperty ;
    rdfs:label "Discharge To Concept ID" ;
    rdfs:comment "Concept for the place of service or type of provider to which the patient was discharged." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/VisitOccurrence_discharge_to_concept_id_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/omop-cdm-schema/VisitOccurrence_discharge_to_concept_id_range> .

:preceding_visit_occurrence_id
    a owl:ObjectProperty ;
    rdfs:label "Preceding Visit Occurrence ID" ;
    rdfs:comment "Links a visit to the immediately preceding visit occurrence for the same patient." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/VisitOccurrence_preceding_visit_occurrence_id_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/omop-cdm-schema/VisitOccurrence_preceding_visit_occurrence_id_range> .

:person_id
    a owl:ObjectProperty ;
    rdfs:label "Person ID" ;
    rdfs:comment "Links a condition occurrence to the patient." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/ConditionOccurrence_person_id_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/omop-cdm-schema/ConditionOccurrence_person_id_range> .

:condition_concept_id
    a owl:ObjectProperty ;
    rdfs:label "Condition Concept ID" ;
    rdfs:comment "Links a condition occurrence to its standardised diagnosis concept (e.g. SNOMED-CT code)." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/ConditionOccurrence_condition_concept_id_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/omop-cdm-schema/ConditionOccurrence_condition_concept_id_range> .

:visit_occurrence_id
    a owl:ObjectProperty ;
    rdfs:label "Visit Occurrence ID" ;
    rdfs:comment "Links a condition occurrence to the enclosing visit occurrence." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/ConditionOccurrence_visit_occurrence_id_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/omop-cdm-schema/ConditionOccurrence_visit_occurrence_id_range> .

:condition_start_datetime
    a owl:DatatypeProperty ;
    rdfs:label "Condition Start Datetime" ;
    rdfs:comment "Date and time when the condition started." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/ConditionOccurrence_condition_start_datetime_domain> ;
    rdfs:range xsd:dateTime .

:condition_end_datetime
    a owl:DatatypeProperty ;
    rdfs:label "Condition End Datetime" ;
    rdfs:comment "Date and time when the condition ended." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/ConditionOccurrence_condition_end_datetime_domain> ;
    rdfs:range xsd:dateTime .

:condition_status_concept_id
    a owl:ObjectProperty ;
    rdfs:label "Condition Status Concept ID" ;
    rdfs:comment "Standardised concept reflecting the current status of the condition (e.g. active, inactive, resolved)." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/ConditionOccurrence_condition_status_concept_id_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/omop-cdm-schema/ConditionOccurrence_condition_status_concept_id_range> .

:stop_reason
    a owl:DatatypeProperty ;
    rdfs:label "Stop Reason" ;
    rdfs:comment "The reason the condition was no longer present, as indicated in the source data." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/ConditionOccurrence_stop_reason_domain> ;
    rdfs:range xsd:string .

:person_id
    a owl:ObjectProperty ;
    rdfs:label "Person ID" ;
    rdfs:comment "Links a drug exposure to the patient who received the drug." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/DrugExposure_person_id_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/omop-cdm-schema/DrugExposure_person_id_range> .

:provider_id
    a owl:ObjectProperty ;
    rdfs:label "Provider ID" ;
    rdfs:comment "Links a drug exposure to the prescribing or administering provider." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/DrugExposure_provider_id_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/omop-cdm-schema/DrugExposure_provider_id_range> .

:drug_concept_id
    a owl:ObjectProperty ;
    rdfs:label "Drug Concept ID" ;
    rdfs:comment "Links a drug exposure to the drug concept (RxNorm or ATC code)." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/DrugExposure_drug_concept_id_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/omop-cdm-schema/DrugExposure_drug_concept_id_range> .

:hasDrugProduct
    a owl:ObjectProperty ;
    rdfs:label "Has Drug Product" ;
    rdfs:comment "Links a drug exposure to the dispensed or administered drug product." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/DrugExposure_hasDrugProduct_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/omop-cdm-schema/DrugExposure_hasDrugProduct_range> .

:hasDoseQuantity
    a owl:ObjectProperty ;
    rdfs:label "Has Dose Quantity" ;
    rdfs:comment "Links a drug exposure to the administered dose quantity." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/DrugExposure_hasDoseQuantity_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/omop-cdm-schema/DrugExposure_hasDoseQuantity_range> .

:visit_occurrence_id
    a owl:ObjectProperty ;
    rdfs:label "Visit Occurrence ID" ;
    rdfs:comment "Links a drug exposure to the enclosing visit occurrence." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/DrugExposure_visit_occurrence_id_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/omop-cdm-schema/DrugExposure_visit_occurrence_id_range> .

:drug_exposure_start_datetime
    a owl:DatatypeProperty ;
    rdfs:label "Drug Exposure Start Datetime" ;
    rdfs:comment "Date and time when the drug exposure started." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/DrugExposure_drug_exposure_start_datetime_domain> ;
    rdfs:range xsd:dateTime .

:drug_exposure_end_datetime
    a owl:DatatypeProperty ;
    rdfs:label "Drug Exposure End Datetime" ;
    rdfs:comment "Date and time when the drug exposure ended." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/DrugExposure_drug_exposure_end_datetime_domain> ;
    rdfs:range xsd:dateTime .

:stop_reason
    a owl:DatatypeProperty ;
    rdfs:label "Stop Reason" ;
    rdfs:comment "The reason the drug was discontinued (e.g. regimen completed, side effects, changed)." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/DrugExposure_stop_reason_domain> ;
    rdfs:range xsd:string .

:quantity
    a owl:DatatypeProperty ;
    rdfs:label "Quantity" ;
    rdfs:comment "The quantity of the drug as recorded in the original prescription or dispensing record." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/DrugExposure_quantity_domain> ;
    rdfs:range xsd:decimal .

:days_supply
    a owl:DatatypeProperty ;
    rdfs:label "Days Supply" ;
    rdfs:comment "Number of days of supply as recorded in the original prescription or dispensing record." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/DrugExposure_days_supply_domain> ;
    rdfs:range xsd:integer .

:refills
    a owl:DatatypeProperty ;
    rdfs:label "Refills" ;
    rdfs:comment "The number of refills after the initial prescription, starting at 0." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/DrugExposure_refills_domain> ;
    rdfs:range xsd:integer .

:person_id
    a owl:ObjectProperty ;
    rdfs:label "Person ID" ;
    rdfs:comment "Links a measurement to the patient it was taken from." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/Measurement_person_id_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/omop-cdm-schema/Measurement_person_id_range> .

:provider_id
    a owl:ObjectProperty ;
    rdfs:label "Provider ID" ;
    rdfs:comment "Links a measurement to the provider who ordered or performed it." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/Measurement_provider_id_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/omop-cdm-schema/Measurement_provider_id_range> .

:hasMeasurementResult
    a owl:ObjectProperty ;
    rdfs:label "Has Measurement Result" ;
    rdfs:comment "Links a measurement to its output result value via an output role." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/Measurement_hasMeasurementResult_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/omop-cdm-schema/Measurement_hasMeasurementResult_range> .

:measurement_concept_id
    a owl:ObjectProperty ;
    rdfs:label "Measurement Concept ID" ;
    rdfs:comment "Links a measurement to its LOINC or SNOMED concept (what was measured)." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/Measurement_measurement_concept_id_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/omop-cdm-schema/Measurement_measurement_concept_id_range> .

:value_as_number
    a owl:DatatypeProperty ;
    rdfs:label "Value As Number" ;
    rdfs:comment "Numeric result of the measurement." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/Measurement_value_as_number_domain> ;
    rdfs:range xsd:float .

:unit_concept_id
    a owl:ObjectProperty ;
    rdfs:label "Unit Concept ID" ;
    rdfs:comment "Links a measurement to its unit of measure." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/Measurement_unit_concept_id_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/omop-cdm-schema/Measurement_unit_concept_id_range> .

:visit_occurrence_id
    a owl:ObjectProperty ;
    rdfs:label "Visit Occurrence ID" ;
    rdfs:comment "Links a measurement to the enclosing visit occurrence." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/Measurement_visit_occurrence_id_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/omop-cdm-schema/Measurement_visit_occurrence_id_range> .

:measurement_datetime
    a owl:DatatypeProperty ;
    rdfs:label "Measurement Datetime" ;
    rdfs:comment "Date and time when the measurement was taken." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/Measurement_measurement_datetime_domain> ;
    rdfs:range xsd:dateTime .

:operator_concept_id
    a owl:ObjectProperty ;
    rdfs:label "Operator Concept ID" ;
    rdfs:comment "Comparison operator applied to the numeric result (e.g. <, <=, =, >=, >)." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/Measurement_operator_concept_id_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/omop-cdm-schema/Measurement_operator_concept_id_range> .

:range_low
    a owl:DatatypeProperty ;
    rdfs:label "Range Low" ;
    rdfs:comment "Lower bound of the normal reference range for this measurement." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/Measurement_range_low_domain> ;
    rdfs:range xsd:decimal .

:range_high
    a owl:DatatypeProperty ;
    rdfs:label "Range High" ;
    rdfs:comment "Upper bound of the normal reference range for this measurement." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/Measurement_range_high_domain> ;
    rdfs:range xsd:decimal .

:person_id
    a owl:ObjectProperty ;
    rdfs:label "Person ID" ;
    rdfs:comment "Links a procedure occurrence to the patient it was performed on." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/ProcedureOccurrence_person_id_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/omop-cdm-schema/ProcedureOccurrence_person_id_range> .

:provider_id
    a owl:ObjectProperty ;
    rdfs:label "Provider ID" ;
    rdfs:comment "Links a procedure occurrence to the provider who performed it." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/ProcedureOccurrence_provider_id_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/omop-cdm-schema/ProcedureOccurrence_provider_id_range> .

:procedure_concept_id
    a owl:ObjectProperty ;
    rdfs:label "Procedure Concept ID" ;
    rdfs:comment "Links a procedure occurrence to its standardised procedure concept." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/ProcedureOccurrence_procedure_concept_id_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/omop-cdm-schema/ProcedureOccurrence_procedure_concept_id_range> .

:visit_occurrence_id
    a owl:ObjectProperty ;
    rdfs:label "Visit Occurrence ID" ;
    rdfs:comment "Links a procedure occurrence to the enclosing visit occurrence." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/ProcedureOccurrence_visit_occurrence_id_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/omop-cdm-schema/ProcedureOccurrence_visit_occurrence_id_range> .

:procedure_datetime
    a owl:DatatypeProperty ;
    rdfs:label "Procedure Datetime" ;
    rdfs:comment "Date and time when the procedure was performed." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/ProcedureOccurrence_procedure_datetime_domain> ;
    rdfs:range xsd:dateTime .

:procedure_end_datetime
    a owl:DatatypeProperty ;
    rdfs:label "Procedure End Datetime" ;
    rdfs:comment "Date and time when the procedure ended." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/ProcedureOccurrence_procedure_end_datetime_domain> ;
    rdfs:range xsd:dateTime .

:person_id
    a owl:ObjectProperty ;
    rdfs:label "Person ID" ;
    rdfs:comment "Links a clinical observation to the patient it concerns." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/Observation_person_id_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/omop-cdm-schema/Observation_person_id_range> .

:observation_concept_id
    a owl:ObjectProperty ;
    rdfs:label "Observation Concept ID" ;
    rdfs:comment "Links an observation to its standardised concept (e.g. smoking status, BMI)." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/Observation_observation_concept_id_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/omop-cdm-schema/Observation_observation_concept_id_range> .

:value_as_string
    a owl:DatatypeProperty ;
    rdfs:label "Value As String" ;
    rdfs:comment "Textual or categorical value of the observation." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/omop-cdm-schema/Observation_value_as_string_domain> ;
