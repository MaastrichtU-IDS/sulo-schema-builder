@prefix : <https://w3id.org/sulo/schema-builder/omop-cdm-schema/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:VisitOccurrenceShape
    a sh:NodeShape, owl:Class ;
    sh:targetClass :VisitOccurrence ;
    rdfs:label "Visit Occurrence" ;
    sh:property [
        sh:path :person_id ;
        sh:name "Person ID" ;
        sh:class :Person ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path :provider_id ;
        sh:name "Provider ID" ;
        sh:class :Provider ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path :care_site_id ;
        sh:name "Care Site ID" ;
        sh:class :CareSite ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path :visit_concept_id ;
        sh:name "Visit Concept ID" ;
        sh:class :Concept ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path :visit_start_datetime ;
        sh:name "Visit Start Datetime" ;
        sh:datatype xsd:dateTime ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path :visit_end_datetime ;
        sh:name "Visit End Datetime" ;
        sh:datatype xsd:dateTime ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path :admitting_source_concept_id ;
        sh:name "Admitting Source Concept ID" ;
        sh:class :Concept ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path :discharge_to_concept_id ;
        sh:name "Discharge To Concept ID" ;
        sh:class :Concept ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path :preceding_visit_occurrence_id ;
        sh:name "Preceding Visit Occurrence ID" ;
        sh:class :VisitOccurrence ;
        sh:minCount 0 ;
    ] ;
    sh:property [
        sh:path :visit_type_concept_id ;
        sh:name "Type Concept ID" ;
        sh:class :Concept ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path :visit_source_concept_id ;
        sh:name "Source Concept ID" ;
        sh:class :Concept ;
        sh:minCount 0 ;
    ] .

