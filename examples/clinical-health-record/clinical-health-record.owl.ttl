@prefix : <https://w3id.org/sulo/schema-builder/clinical-health-record/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix sulo: <https://w3id.org/sulo/> .

<https://w3id.org/sulo/schema-builder/clinical-health-record>
    a owl:Ontology ;
    dct:title "Clinical Health Record Schema" ;
    dct:description "Example schema covering core clinical concepts: visits, lab results, procedures, conditions, severity, treatments, and drugs (the case study from the SULO Schema Builder paper)." ;
    owl:imports <https://w3id.org/sulo/> .

# ── Classes ──────────────────────────────────────────────────────────────

:ClinicalVisit
    a owl:Class ;
    rdfs:label "Clinical Visit" ;
    rdfs:comment "A healthcare encounter between a patient and a provider." ;
    rdfs:subClassOf sulo:Process .

:Measurement
    a owl:Class ;
    rdfs:label "Measurement" ;
    rdfs:comment "The outcome of a laboratory test or diagnostic analysis." ;
    rdfs:subClassOf sulo:InformationObject .

:MedicalProcedure
    a owl:Class ;
    rdfs:label "Medical Procedure" ;
    rdfs:comment "A clinical action or intervention performed on a patient." ;
    rdfs:subClassOf sulo:Process .

:ClinicalCondition
    a owl:Class ;
    rdfs:label "Clinical Condition" ;
    rdfs:comment "A medical condition, disease, or disorder affecting a patient." ;
    rdfs:subClassOf sulo:Process .

:Severity
    a owl:Class ;
    rdfs:label "Severity" ;
    rdfs:comment "The degree of seriousness of a condition, symptom, or finding." ;
    rdfs:subClassOf sulo:Quality .

:TreatmentPlan
    a owl:Class ;
    rdfs:label "Treatment / Treatment Plan" ;
    rdfs:comment "A drug administration event or planned course of treatment." ;
    rdfs:subClassOf sulo:Process .

:SubjectOfCareRole
    a owl:Class ;
    rdfs:label "Subject of Care Role" ;
    rdfs:comment "The role played by a person who is the subject of a care activity." ;
    rdfs:subClassOf sulo:Role .

:CareProviderRole
    a owl:Class ;
    rdfs:label "Care Provider Role" ;
    rdfs:comment "The role played by a person or organisation providing care." ;
    rdfs:subClassOf sulo:Role .

:Person
    a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A human being, either as a patient or a care participant." ;
    rdfs:subClassOf sulo:SpatialObject .

:AnatomicalStructure
    a owl:Class ;
    rdfs:label "Anatomical Structure" ;
    rdfs:comment "A body part or anatomical site relevant to a clinical finding or procedure." ;
    rdfs:subClassOf sulo:SpatialObject .

:PerformerRole
    a owl:Class ;
    rdfs:label "Performer Role" ;
    rdfs:comment "The role of an agent who performs a clinical action or procedure." ;
    rdfs:subClassOf sulo:Role .

:ProcessStatus
    a owl:Class ;
    rdfs:label "Process Status" ;
    rdfs:comment "The state or status of a clinical process or workflow step." ;
    rdfs:subClassOf sulo:Quality .

:PharmaceuticalDose
    a owl:Class ;
    rdfs:label "Pharmaceutical Dose" ;
    rdfs:comment "The quantity and form of a drug administered in a single instance." ;
    rdfs:subClassOf sulo:Quantity .

:OutputRole
    a owl:Class ;
    rdfs:label "Output Role" ;
    rdfs:comment "The role of an entity produced as an output of a clinical process." ;
    rdfs:subClassOf sulo:Role .

:InstrumentRole
    a owl:Class ;
    rdfs:label "Instrument Role" ;
    rdfs:comment "The role of a device or tool used in a clinical procedure." ;
    rdfs:subClassOf sulo:Role .

:CareUnit
    a owl:Class ;
    rdfs:label "Care Unit" ;
    rdfs:comment "An organisational unit responsible for delivering a type of care." ;
    rdfs:subClassOf sulo:SpatialObject .

:MeasurementProcess
    a owl:Class ;
    rdfs:label "Measurement Process" ;
    rdfs:comment "A process of measuring or quantifying a clinical observable or parameter." ;
    rdfs:subClassOf :MedicalProcedure ;
    rdfs:subClassOf sulo:Process .

:Device
    a owl:Class ;
    rdfs:label "Device" ;
    rdfs:comment "A physical instrument or medical device used in a clinical or diagnostic process." ;
    rdfs:subClassOf sulo:SpatialObject .

:CarePlan
    a owl:Class ;
    rdfs:label "Care Plan" ;
    rdfs:comment "A structured set of intended actions or treatments for a patient." ;
    rdfs:subClassOf sulo:InformationObject .

:Occupation
    a owl:Class ;
    rdfs:label "Occupation" ;
    rdfs:comment "A job, profession, or occupational role held by a person." ;
    rdfs:subClassOf sulo:SpatialObject .

:EvaluationProcess
    a owl:Class ;
    rdfs:label "Evaluation Process" ;
    rdfs:comment "A process of assessing or evaluating a clinical finding, condition, or patient state." ;
    rdfs:subClassOf :MedicalProcedure ;
    rdfs:subClassOf sulo:Process .

:MedicationAdministration
    a owl:Class ;
    rdfs:label "Medication Administration" ;
    rdfs:comment "A process of administering a drug or pharmaceutical substance to a patient." ;
    rdfs:subClassOf :MedicalProcedure ;
    rdfs:subClassOf sulo:Process .

:PharmaceuticalProduct
    a owl:Class ;
    rdfs:label "Pharmaceutical Product" ;
    rdfs:comment "A drug or medicinal product used in the treatment or prevention of disease." ;
    rdfs:subClassOf sulo:SpatialObject .

:PharmaceuticalDoseForm
    a owl:Class ;
    rdfs:label "Pharmaceutical Dose Form" ;
    rdfs:comment "The physical form of a pharmaceutical product (e.g. tablet, capsule, solution)." ;
    rdfs:subClassOf sulo:Quality .

:DiagnosticStatement
    a owl:Class ;
    rdfs:label "Diagnostic Statement" ;
    rdfs:comment "An information object representing a diagnostic finding or clinical assertion." ;
    rdfs:subClassOf sulo:InformationObject .

:Code
    a owl:Class ;
    rdfs:label "Code" ;
    rdfs:comment "A terminology code bundling an identifier, its coding system/version, and an optional display name." ;
    rdfs:subClassOf sulo:InformationObject .

<http://snomed.info/id/363787002>
    a owl:Class ;
    rdfs:label "Observable Entity" ;
    rdfs:comment "A SNOMED CT observable entity — a concept that can be measured or observed in a clinical or scientific context." ;
    rdfs:subClassOf :Code ;
    rdfs:subClassOf <http://snomed.info/id/363787002> .

<http://snomed.info/id/71388002>
    a owl:Class ;
    rdfs:label "SCT Procedure" ;
    rdfs:comment "A SNOMED CT procedure concept — a clinical action or intervention performed on or for a patient." ;
    rdfs:subClassOf :Code ;
    rdfs:subClassOf <http://snomed.info/id/71388002> .

:AdministrativeCase
    a owl:Class ;
    rdfs:label "Administrative Case" ;
    rdfs:comment "An administrative hospital case grouping a patient’s clinical visits." ;
    rdfs:subClassOf sulo:Process .

:Sample
    a owl:Class ;
    rdfs:label "Sample" ;
    rdfs:comment "A biological specimen collected from a patient for laboratory analysis." ;
    rdfs:subClassOf sulo:SpatialObject .

:Substance
    a owl:Class ;
    rdfs:label "Substance" ;
    rdfs:comment "A material substance, e.g. the active ingredient of a pharmaceutical product." ;
    rdfs:subClassOf sulo:SpatialObject .

:DrugPrescription
    a owl:Class ;
    rdfs:label "Drug Prescription" ;
    rdfs:comment "An information object representing a prescription or order for a drug." ;
    rdfs:subClassOf sulo:InformationObject .

# ── Properties ───────────────────────────────────────────────────────────

:hasPatient
    a owl:ObjectProperty ;
    rdfs:label "Has Patient" ;
    rdfs:comment "Links a clinical visit to the patient (subject of care)." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/9ef01b0d-0fa0-48ab-9f9a-2ba3c2223392> ;
    rdfs:range <https://w3id.org/sulo/schema/resource/ontology-class/ce6cc09b-6861-4b2f-9352-c9ee91958278> .

:hasCareProvider
    a owl:ObjectProperty ;
    rdfs:label "Has Care Provider" ;
    rdfs:comment "Links a clinical visit to the care provider." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/93e07f81-0750-4a7f-bee4-033973311925> ;
    rdfs:range <https://w3id.org/sulo/schema/resource/ontology-class/17b9076a-02ba-4348-a7c7-509456b886b0> .

:hasCareUnit
    a owl:ObjectProperty ;
    rdfs:label "Has Care Unit" ;
    rdfs:comment "Links a clinical visit to the care unit where it takes place." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/9b8d6049-05fb-4c8d-8649-67e65358b69e> ;
    rdfs:range <https://w3id.org/sulo/schema/resource/ontology-class/cb88c4d1-0c50-4462-bfbb-97262fac0447> .

:hasPatient
    a owl:ObjectProperty ;
    rdfs:label "Has Patient" ;
    rdfs:comment "Links a medical procedure to the patient it is performed on." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/1731d959-4462-425f-b3c5-69daa3dfb2ad> ;
    rdfs:range <https://w3id.org/sulo/schema/resource/ontology-class/377b5455-7050-493b-9771-c29a5a858c5f> .

:hasPerformer
    a owl:ObjectProperty ;
    rdfs:label "Has Performer" ;
    rdfs:comment "Links a medical procedure to the person who performed it." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/2520d9a3-f385-4c0a-913f-b512e1404c55> ;
    rdfs:range <https://w3id.org/sulo/schema/resource/ontology-class/9c59f80c-3456-418d-a847-57971ebbda77> .

:hasPerformedDate
    a owl:DatatypeProperty ;
    rdfs:label "Has Performed Date" ;
    rdfs:comment "Links a medical procedure to the date and time it was performed." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/f8414006-9c5f-4274-9933-2a24ee04d668> ;
    rdfs:range xsd:dateTime .

:hasStatus
    a owl:ObjectProperty ;
    rdfs:label "Has Status" ;
    rdfs:comment "Links a medical procedure to its current status." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/72f08911-eab1-4f63-9bac-a3e28a671f6a> ;
    rdfs:range <https://w3id.org/sulo/schema/resource/ontology-class/66aa09a8-a45b-4f38-8b5b-646c7269e61f> .

:hasDevice
    a owl:ObjectProperty ;
    rdfs:label "Has Device" ;
    rdfs:comment "Links a measurement process to the device used as an instrument." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/52b239b0-f783-47db-8f0c-8b6e07a05acc> ;
    rdfs:range <https://w3id.org/sulo/schema/resource/ontology-class/2b96177c-b069-4981-a9f9-60383e6c3124> .

:hasMeasuredDate
    a owl:DatatypeProperty ;
    rdfs:label "Has Measured Date" ;
    rdfs:comment "Links a measurement to the date and time it was recorded." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/167d3a96-6d5b-412f-b56a-d6c9f460cdfa> ;
    rdfs:range xsd:dateTime .

:hasUnit
    a owl:ObjectProperty ;
    rdfs:label "Has Unit" ;
    rdfs:comment "Links a measurement to its unit of measure." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/8e45d649-dabf-4d49-8b55-f1a4c8cf01a2> ;
    rdfs:range sulo:Unit .

:hasQuantityValue
    a owl:DatatypeProperty ;
    rdfs:label "Has Quantity Value" ;
    rdfs:comment "Links a measurement to its numeric quantity value." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/5e96ad7c-cecd-47fc-9842-04b17a3a7165> ;
    rdfs:range xsd:float .

:hasResult
    a owl:ObjectProperty ;
    rdfs:label "Has Result" ;
    rdfs:comment "Links a measurement process to its result via an output role." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/a93e71c4-2d5b-4723-ac0a-7bb95a039568> ;
    rdfs:range <https://w3id.org/sulo/schema/resource/ontology-class/4f88d263-5434-4f7f-81b2-f21b704e993b> .

:hasRecordDate
    a owl:DatatypeProperty ;
    rdfs:label "Has Record Date" ;
    rdfs:comment "Links a clinical condition to the date and time it was recorded." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/d483dd3b-4e37-4d58-99fd-0f82dd268bd5> ;
    rdfs:range xsd:dateTime .

:hasConditionEndDate
    a owl:DatatypeProperty ;
    rdfs:label "Has Condition End Date" ;
    rdfs:comment "Links a clinical condition to the date and time it ended." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/a101dab2-c06a-4940-beb8-73f4f6607ceb> ;
    rdfs:range xsd:dateTime .

:hasLocatedIn
    a owl:ObjectProperty ;
    rdfs:label "Has Located In" ;
    rdfs:comment "Links a clinical condition to the anatomical structure where it is located." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/9f65ad15-955e-4931-a1e7-130a0a883f4e> ;
    rdfs:range <https://w3id.org/sulo/schema/resource/ontology-class/09a9c249-9e14-41aa-bb25-a8627e7cea8c> .

:hasSeverity
    a owl:ObjectProperty ;
    rdfs:label "Has Severity" ;
    rdfs:comment "Links a clinical condition to its severity." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/b5b999e4-43c8-4b56-b8da-07a32ec9d05e> ;
    rdfs:range <https://w3id.org/sulo/schema/resource/ontology-class/48499661-7ca0-428f-b071-8fb5cdc92813> .

:hasMedicalProcedure
    a owl:ObjectProperty ;
    rdfs:label "Has Medical Procedure" ;
    rdfs:comment "Links a plan to the medical procedure it refers to." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/7e9fb25e-8be0-41e7-8fd6-85ea3cf34a88> ;
    rdfs:range <https://w3id.org/sulo/schema/resource/ontology-class/22d43d73-2d99-4f76-b977-5e66b9682d81> .

:hasObservation
    a owl:ObjectProperty ;
    rdfs:label "Has Observation" ;
    rdfs:comment "Links an evaluation process to the diagnostic statement produced as its output." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/6fc5ea90-4559-4725-816f-8d3cf0b05882> ;
    rdfs:range <https://w3id.org/sulo/schema/resource/ontology-class/5a266bb0-a31f-4a46-9414-6d5275997f5d> .

:hasDoseQuantity
    a owl:ObjectProperty ;
    rdfs:label "Has Dose Quantity" ;
    rdfs:comment "Links a pharmaceutical product to its dose quantity." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/025c3897-a548-4404-8b6a-d78476875391> ;
    rdfs:range <https://w3id.org/sulo/schema/resource/ontology-class/eeeab1c0-40bf-451d-b004-4f1151cf73d6> .

:hasDoseForm
    a owl:ObjectProperty ;
    rdfs:label "Has Dose Form" ;
    rdfs:comment "Links a pharmaceutical product to its dose form." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/28e1c56e-fb6c-49c7-a34c-710340bae92d> ;
    rdfs:range <https://w3id.org/sulo/schema/resource/ontology-class/77759786-d369-469e-8dd3-0cad91883de8> .

:hasPharmaceuticalProduct
    a owl:ObjectProperty ;
    rdfs:label "Has Pharmaceutical Product" ;
    rdfs:comment "Links a medication administration to the pharmaceutical product being administered." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/f3f9cfc6-cebc-4541-8409-d7b0d1fb3dbb> ;
    rdfs:range <https://w3id.org/sulo/schema/resource/ontology-class/ad4539df-00e0-4c91-b8bc-96f996a91e01> .

:hasIdentifier
    a owl:DatatypeProperty ;
    rdfs:label "Has Identifier" ;
    rdfs:comment "The code string itself (e.g. \"73211009\" for SNOMED CT, \"J18.9\" for ICD-10)." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/81a596a6-3794-4dce-8f8b-c19bf278fc9e> ;
    rdfs:range xsd:string .

:hasCodingSystemAndVersion
    a owl:DatatypeProperty ;
    rdfs:label "Has Coding System And Version" ;
    rdfs:comment "Name and version of the coding system (e.g. \"SNOMED CT 2024-03\", \"ICD-10-CM 2024\", \"LOINC 2.76\")." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/271894f0-c200-45c9-a0a0-a7c86c16a59c> ;
    rdfs:range xsd:string .

:hasName
    a owl:DatatypeProperty ;
    rdfs:label "Has Name" ;
    rdfs:comment "Human-readable display name for the code (e.g. \"Pneumonia, unspecified organism\")." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/a4639b5a-4ffa-441e-a261-cc0731062d91> ;
    rdfs:range xsd:string .

:hasCode
    a owl:ObjectProperty ;
    rdfs:label "Has Code" ;
    rdfs:comment "Links a Clinical Condition instance to its terminology code (SNOMED CT, ICD-10, LOINC, ATC, etc.)." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/1cd5befd-26e6-4760-b5b8-02d9830e12ab> ;
    rdfs:range <https://w3id.org/sulo/schema/resource/ontology-class/79196644-ded8-486a-90fe-107b8402447e> .

:hasCode
    a owl:ObjectProperty ;
    rdfs:label "Has Code" ;
    rdfs:comment "Links a Clinical Visit instance to its terminology code (SNOMED CT, ICD-10, LOINC, ATC, etc.)." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/791f7892-d694-42a9-990a-da238e5cdd91> ;
    rdfs:range <https://w3id.org/sulo/schema/resource/ontology-class/0f25a230-6f4a-4fef-a4af-e1b1a138c26d> .

:hasCode
    a owl:ObjectProperty ;
    rdfs:label "Has Code" ;
    rdfs:comment "Links a Medical Procedure instance to its terminology code (SNOMED CT, ICD-10, LOINC, ATC, etc.)." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/adf4c4a5-fd90-468a-b9c4-5c3d7db2d3fc> ;
    rdfs:range [ owl:unionOf (:Code <http://snomed.info/id/71388002>) ] .

:hasCode
    a owl:ObjectProperty ;
    rdfs:label "Has Code" ;
    rdfs:comment "Links a Measurement instance to its terminology code (SNOMED CT, ICD-10, LOINC, ATC, etc.)." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/543a0d83-abab-409a-82d9-85e7d8eeca70> ;
    rdfs:range [ owl:unionOf (:Code <http://snomed.info/id/363787002>) ] .

:hasCode
    a owl:ObjectProperty ;
    rdfs:label "Has Code" ;
    rdfs:comment "Links a Medication Administration instance to its terminology code (SNOMED CT, ICD-10, LOINC, ATC, etc.)." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/45c7c5a6-a5bd-4465-b2b3-018579c1e425> ;
    rdfs:range <https://w3id.org/sulo/schema/resource/ontology-class/a38c6117-39d7-44f4-864c-f37bf9a997b7> .

:hasCode
    a owl:ObjectProperty ;
    rdfs:label "Has Code" ;
    rdfs:comment "Links a Anatomical Structure instance to its terminology code (SNOMED CT, ICD-10, LOINC, ATC, etc.)." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/fabbd4d8-495e-495a-be96-e5383963c941> ;
    rdfs:range <https://w3id.org/sulo/schema/resource/ontology-class/c52fc027-681f-420f-aa1e-227d6c93fc99> .

:hasCode
    a owl:ObjectProperty ;
    rdfs:label "Has Code" ;
    rdfs:comment "Links a Severity instance to its terminology code (SNOMED CT, ICD-10, LOINC, ATC, etc.)." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/2a4bd9a8-0067-4e67-b7d1-9eba18771ac4> ;
    rdfs:range <https://w3id.org/sulo/schema/resource/ontology-class/371fb5d8-4102-4bfa-9805-7e0159ecf262> .

:hasCode
    a owl:ObjectProperty ;
    rdfs:label "Has Code" ;
    rdfs:comment "Links a Pharmaceutical Product instance to its terminology code (SNOMED CT, ICD-10, LOINC, ATC, etc.)." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/45ddcd7a-6aed-4c2f-9224-681a0c2d5a83> ;
    rdfs:range <https://w3id.org/sulo/schema/resource/ontology-class/65f8da2e-c1a5-40ac-b9dc-fd6f96633a55> .

:hasAdministrativeCase
    a owl:ObjectProperty ;
    rdfs:label "Has Administrative Case" ;
    rdfs:comment "Links a clinical visit to the administrative case it belongs to." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/ad178120-769d-4c25-8da9-a06d5ec98334> ;
    rdfs:range <https://w3id.org/sulo/schema/resource/ontology-class/be8b0b6d-ddc1-4c11-bca4-f604b91e7d5a> .

:hasPatient
    a owl:ObjectProperty ;
    rdfs:label "Has Patient" ;
    rdfs:comment "Links an administrative case to the patient it concerns." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/9ea1d443-b0a8-4cc0-a5ac-812dd80a68af> ;
    rdfs:range <https://w3id.org/sulo/schema/resource/ontology-class/0b7809e6-18de-4da9-b611-d2b7db6dab22> .

:hasSample
    a owl:ObjectProperty ;
    rdfs:label "Has Sample" ;
    rdfs:comment "Links a measurement process to the sample it is performed on." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/f91a44a9-27b7-4311-83bb-c9a3828971db> ;
    rdfs:range <https://w3id.org/sulo/schema/resource/ontology-class/60c31bbd-20eb-4d32-bcb9-a634ad6b7306> .

:collectedFrom
    a owl:ObjectProperty ;
    rdfs:label "Collected From" ;
    rdfs:comment "Links a sample to the patient it was collected from." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/2ceb1bb1-56b6-4502-8014-5bf6cce6008d> ;
    rdfs:range <https://w3id.org/sulo/schema/resource/ontology-class/1bbc2af6-0c0f-42e6-8958-220dc0b04ccc> .

:hasSubstance
    a owl:ObjectProperty ;
    rdfs:label "Has Substance" ;
    rdfs:comment "Links a pharmaceutical product to its active substance." ;
    rdfs:domain <https://w3id.org/sulo/schema/resource/ontology-class/e197f8a6-4004-43fd-b819-6d3921b7cc7c> ;
    rdfs:range <https://w3id.org/sulo/schema/resource/ontology-class/2680d69b-3471-47bd-a177-92c8b5e8a300> .

:prescribesDrug
    a owl:ObjectProperty ;
    rdfs:label "Prescribes Drug" ;
    rdfs:comment "Links a drug prescription to the pharmaceutical product it prescribes." ;
