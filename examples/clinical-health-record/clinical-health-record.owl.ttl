@prefix : <https://w3id.org/sulo/schema-builder/clinical-health-record/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix sulo: <https://w3id.org/sulo/> .

<https://w3id.org/sulo/schema-builder/clinical-health-record>
    a owl:Ontology ;
    dct:title "Clinical Health Record Schema" ;
    dct:description "Example schema covering core clinical concepts: visits, lab results, procedures, conditions, severity, treatments, and drugs (the case study from the SULO Schema Builder paper)." ;
    owl:imports <https://w3id.org/sulo/> .

# ── Classes ──────────────────────────────────────────────────────────────

:ClinicalVisit
    a owl:Class ;
    rdfs:label "Clinical Visit" ;
    rdfs:comment "A healthcare encounter between a patient and a provider." ;
    rdfs:subClassOf sulo:Process .

:Measurement
    a owl:Class ;
    rdfs:label "Measurement" ;
    rdfs:comment "The outcome of a laboratory test or diagnostic analysis." ;
    rdfs:subClassOf sulo:InformationObject .

:MedicalProcedure
    a owl:Class ;
    rdfs:label "Medical Procedure" ;
    rdfs:comment "A clinical action or intervention performed on a patient." ;
    rdfs:subClassOf sulo:Process .

:ClinicalCondition
    a owl:Class ;
    rdfs:label "Clinical Condition" ;
    rdfs:comment "A medical condition, disease, or disorder affecting a patient." ;
    rdfs:subClassOf sulo:Process .

:Severity
    a owl:Class ;
    rdfs:label "Severity" ;
    rdfs:comment "The degree of seriousness of a condition, symptom, or finding." ;
    rdfs:subClassOf sulo:Quality .

:TreatmentPlan
    a owl:Class ;
    rdfs:label "Treatment / Treatment Plan" ;
    rdfs:comment "A drug administration event or planned course of treatment." ;
    rdfs:subClassOf sulo:Process .

:SubjectOfCareRole
    a owl:Class ;
    rdfs:label "Subject of Care Role" ;
    rdfs:comment "The role played by a person who is the subject of a care activity." ;
    rdfs:subClassOf sulo:Role .

:CareProviderRole
    a owl:Class ;
    rdfs:label "Care Provider Role" ;
    rdfs:comment "The role played by a person or organisation providing care." ;
    rdfs:subClassOf sulo:Role .

:Person
    a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A human being, either as a patient or a care participant." ;
    rdfs:subClassOf sulo:SpatialObject .

:AnatomicalStructure
    a owl:Class ;
    rdfs:label "Anatomical Structure" ;
    rdfs:comment "A body part or anatomical site relevant to a clinical finding or procedure." ;
    rdfs:subClassOf sulo:SpatialObject .

:PerformerRole
    a owl:Class ;
    rdfs:label "Performer Role" ;
    rdfs:comment "The role of an agent who performs a clinical action or procedure." ;
    rdfs:subClassOf sulo:Role .

:ProcessStatus
    a owl:Class ;
    rdfs:label "Process Status" ;
    rdfs:comment "The state or status of a clinical process or workflow step." ;
    rdfs:subClassOf sulo:Quality .

:PharmaceuticalDose
    a owl:Class ;
    rdfs:label "Pharmaceutical Dose" ;
    rdfs:comment "The quantity and form of a drug administered in a single instance." ;
    rdfs:subClassOf sulo:Quantity .

:OutputRole
    a owl:Class ;
    rdfs:label "Output Role" ;
    rdfs:comment "The role of an entity produced as an output of a clinical process." ;
    rdfs:subClassOf sulo:Role .

:InstrumentRole
    a owl:Class ;
    rdfs:label "Instrument Role" ;
    rdfs:comment "The role of a device or tool used in a clinical procedure." ;
    rdfs:subClassOf sulo:Role .

:CareUnit
    a owl:Class ;
    rdfs:label "Care Unit" ;
    rdfs:comment "An organisational unit responsible for delivering a type of care." ;
    rdfs:subClassOf sulo:SpatialObject .

:MeasurementProcess
    a owl:Class ;
    rdfs:label "Measurement Process" ;
    rdfs:comment "A process of measuring or quantifying a clinical observable or parameter." ;
    rdfs:subClassOf :MedicalProcedure ;
    rdfs:subClassOf sulo:Process .

:Device
    a owl:Class ;
    rdfs:label "Device" ;
    rdfs:comment "A physical instrument or medical device used in a clinical or diagnostic process." ;
    rdfs:subClassOf sulo:SpatialObject .

:CarePlan
    a owl:Class ;
    rdfs:label "Care Plan" ;
    rdfs:comment "A structured set of intended actions or treatments for a patient." ;
    rdfs:subClassOf sulo:InformationObject .

:Occupation
    a owl:Class ;
    rdfs:label "Occupation" ;
    rdfs:comment "A job, profession, or occupational role held by a person." ;
    rdfs:subClassOf sulo:SpatialObject .

:EvaluationProcess
    a owl:Class ;
    rdfs:label "Evaluation Process" ;
    rdfs:comment "A process of assessing or evaluating a clinical finding, condition, or patient state." ;
    rdfs:subClassOf :MedicalProcedure ;
    rdfs:subClassOf sulo:Process .

:MedicationAdministration
    a owl:Class ;
    rdfs:label "Medication Administration" ;
    rdfs:comment "A process of administering a drug or pharmaceutical substance to a patient." ;
    rdfs:subClassOf :MedicalProcedure ;
    rdfs:subClassOf sulo:Process .

:PharmaceuticalProduct
    a owl:Class ;
    rdfs:label "Pharmaceutical Product" ;
    rdfs:comment "A drug or medicinal product used in the treatment or prevention of disease." ;
    rdfs:subClassOf sulo:SpatialObject .

:PharmaceuticalDoseForm
    a owl:Class ;
    rdfs:label "Pharmaceutical Dose Form" ;
    rdfs:comment "The physical form of a pharmaceutical product (e.g. tablet, capsule, solution)." ;
    rdfs:subClassOf sulo:Quality .

:DiagnosticStatement
    a owl:Class ;
    rdfs:label "Diagnostic Statement" ;
    rdfs:comment "An information object representing a diagnostic finding or clinical assertion." ;
    rdfs:subClassOf sulo:InformationObject .

:Code
    a owl:Class ;
    rdfs:label "Code" ;
    rdfs:comment "A terminology code bundling an identifier, its coding system/version, and an optional display name." ;
    rdfs:subClassOf sulo:InformationObject .

<http://snomed.info/id/363787002>
    a owl:Class ;
    rdfs:label "Observable Entity" ;
    rdfs:comment "A SNOMED CT observable entity — a concept that can be measured or observed in a clinical or scientific context." ;
    rdfs:subClassOf :Code ;
    rdfs:subClassOf <http://snomed.info/id/363787002> .

<http://snomed.info/id/71388002>
    a owl:Class ;
    rdfs:label "SCT Procedure" ;
    rdfs:comment "A SNOMED CT procedure concept — a clinical action or intervention performed on or for a patient." ;
    rdfs:subClassOf :Code ;
    rdfs:subClassOf <http://snomed.info/id/71388002> .

:AdministrativeCase
    a owl:Class ;
    rdfs:label "Administrative Case" ;
    rdfs:comment "An administrative hospital case grouping a patient’s clinical visits." ;
    rdfs:subClassOf sulo:Process .

:Sample
    a owl:Class ;
    rdfs:label "Sample" ;
    rdfs:comment "A biological specimen collected from a patient for laboratory analysis." ;
    rdfs:subClassOf sulo:SpatialObject .

:Substance
    a owl:Class ;
    rdfs:label "Substance" ;
    rdfs:comment "A material substance, e.g. the active ingredient of a pharmaceutical product." ;
    rdfs:subClassOf sulo:SpatialObject .

:DrugPrescription
    a owl:Class ;
    rdfs:label "Drug Prescription" ;
    rdfs:comment "An information object representing a prescription or order for a drug." ;
    rdfs:subClassOf sulo:InformationObject .

# ── Properties ───────────────────────────────────────────────────────────

:hasPatient
    a owl:ObjectProperty ;
    rdfs:label "Has Patient" ;
    rdfs:comment "Links a clinical visit to the patient (subject of care)." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/ClinicalVisit_hasPatient_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/clinical-health-record/ClinicalVisit_hasPatient_range> .

:hasCareProvider
    a owl:ObjectProperty ;
    rdfs:label "Has Care Provider" ;
    rdfs:comment "Links a clinical visit to the care provider." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/ClinicalVisit_hasCareProvider_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/clinical-health-record/ClinicalVisit_hasCareProvider_range> .

:hasCareUnit
    a owl:ObjectProperty ;
    rdfs:label "Has Care Unit" ;
    rdfs:comment "Links a clinical visit to the care unit where it takes place." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/ClinicalVisit_hasCareUnit_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/clinical-health-record/ClinicalVisit_hasCareUnit_range> .

:hasPatient
    a owl:ObjectProperty ;
    rdfs:label "Has Patient" ;
    rdfs:comment "Links a medical procedure to the patient it is performed on." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/MedicalProcedure_hasPatient_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/clinical-health-record/MedicalProcedure_hasPatient_range> .

:hasPerformer
    a owl:ObjectProperty ;
    rdfs:label "Has Performer" ;
    rdfs:comment "Links a medical procedure to the person who performed it." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/MedicalProcedure_hasPerformer_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/clinical-health-record/MedicalProcedure_hasPerformer_range> .

:hasPerformedDate
    a owl:DatatypeProperty ;
    rdfs:label "Has Performed Date" ;
    rdfs:comment "Links a medical procedure to the date and time it was performed." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/MedicalProcedure_hasPerformedDate_domain> ;
    rdfs:range xsd:dateTime .

:hasStatus
    a owl:ObjectProperty ;
    rdfs:label "Has Status" ;
    rdfs:comment "Links a medical procedure to its current status." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/MedicalProcedure_hasStatus_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/clinical-health-record/MedicalProcedure_hasStatus_range> .

:hasDevice
    a owl:ObjectProperty ;
    rdfs:label "Has Device" ;
    rdfs:comment "Links a measurement process to the device used as an instrument." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/MeasurementProcess_hasDevice_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/clinical-health-record/MeasurementProcess_hasDevice_range> .

:hasMeasuredDate
    a owl:DatatypeProperty ;
    rdfs:label "Has Measured Date" ;
    rdfs:comment "Links a measurement to the date and time it was recorded." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/Measurement_hasMeasuredDate_domain> ;
    rdfs:range xsd:dateTime .

:hasUnit
    a owl:ObjectProperty ;
    rdfs:label "Has Unit" ;
    rdfs:comment "Links a measurement to its unit of measure." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/Measurement_hasUnit_domain> ;
    rdfs:range sulo:Unit .

:hasQuantityValue
    a owl:DatatypeProperty ;
    rdfs:label "Has Quantity Value" ;
    rdfs:comment "Links a measurement to its numeric quantity value." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/Measurement_hasQuantityValue_domain> ;
    rdfs:range xsd:float .

:hasResult
    a owl:ObjectProperty ;
    rdfs:label "Has Result" ;
    rdfs:comment "Links a measurement process to its result via an output role." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/MeasurementProcess_hasResult_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/clinical-health-record/MeasurementProcess_hasResult_range> .

:hasRecordDate
    a owl:DatatypeProperty ;
    rdfs:label "Has Record Date" ;
    rdfs:comment "Links a clinical condition to the date and time it was recorded." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/ClinicalCondition_hasRecordDate_domain> ;
    rdfs:range xsd:dateTime .

:hasConditionEndDate
    a owl:DatatypeProperty ;
    rdfs:label "Has Condition End Date" ;
    rdfs:comment "Links a clinical condition to the date and time it ended." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/ClinicalCondition_hasConditionEndDate_domain> ;
    rdfs:range xsd:dateTime .

:hasLocatedIn
    a owl:ObjectProperty ;
    rdfs:label "Has Located In" ;
    rdfs:comment "Links a clinical condition to the anatomical structure where it is located." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/ClinicalCondition_hasLocatedIn_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/clinical-health-record/ClinicalCondition_hasLocatedIn_range> .

:hasSeverity
    a owl:ObjectProperty ;
    rdfs:label "Has Severity" ;
    rdfs:comment "Links a clinical condition to its severity." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/ClinicalCondition_hasSeverity_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/clinical-health-record/ClinicalCondition_hasSeverity_range> .

:hasMedicalProcedure
    a owl:ObjectProperty ;
    rdfs:label "Has Medical Procedure" ;
    rdfs:comment "Links a plan to the medical procedure it refers to." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/CarePlan_hasMedicalProcedure_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/clinical-health-record/CarePlan_hasMedicalProcedure_range> .

:hasObservation
    a owl:ObjectProperty ;
    rdfs:label "Has Observation" ;
    rdfs:comment "Links an evaluation process to the diagnostic statement produced as its output." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/EvaluationProcess_hasObservation_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/clinical-health-record/EvaluationProcess_hasObservation_range> .

:hasDoseQuantity
    a owl:ObjectProperty ;
    rdfs:label "Has Dose Quantity" ;
    rdfs:comment "Links a pharmaceutical product to its dose quantity." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/PharmaceuticalProduct_hasDoseQuantity_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/clinical-health-record/PharmaceuticalProduct_hasDoseQuantity_range> .

:hasDoseForm
    a owl:ObjectProperty ;
    rdfs:label "Has Dose Form" ;
    rdfs:comment "Links a pharmaceutical product to its dose form." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/PharmaceuticalProduct_hasDoseForm_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/clinical-health-record/PharmaceuticalProduct_hasDoseForm_range> .

:hasPharmaceuticalProduct
    a owl:ObjectProperty ;
    rdfs:label "Has Pharmaceutical Product" ;
    rdfs:comment "Links a medication administration to the pharmaceutical product being administered." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/MedicationAdministration_hasPharmaceuticalProduct_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/clinical-health-record/MedicationAdministration_hasPharmaceuticalProduct_range> .

:hasIdentifier
    a owl:DatatypeProperty ;
    rdfs:label "Has Identifier" ;
    rdfs:comment "The code string itself (e.g. \"73211009\" for SNOMED CT, \"J18.9\" for ICD-10)." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/Code_hasIdentifier_domain> ;
    rdfs:range xsd:string .

:hasCodingSystemAndVersion
    a owl:DatatypeProperty ;
    rdfs:label "Has Coding System And Version" ;
    rdfs:comment "Name and version of the coding system (e.g. \"SNOMED CT 2024-03\", \"ICD-10-CM 2024\", \"LOINC 2.76\")." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/Code_hasCodingSystemAndVersion_domain> ;
    rdfs:range xsd:string .

:hasName
    a owl:DatatypeProperty ;
    rdfs:label "Has Name" ;
    rdfs:comment "Human-readable display name for the code (e.g. \"Pneumonia, unspecified organism\")." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/Code_hasName_domain> ;
    rdfs:range xsd:string .

:hasCode
    a owl:ObjectProperty ;
    rdfs:label "Has Code" ;
    rdfs:comment "Links a Clinical Condition instance to its terminology code (SNOMED CT, ICD-10, LOINC, ATC, etc.)." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/ClinicalCondition_hasCode_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/clinical-health-record/ClinicalCondition_hasCode_range> .

:hasCode
    a owl:ObjectProperty ;
    rdfs:label "Has Code" ;
    rdfs:comment "Links a Clinical Visit instance to its terminology code (SNOMED CT, ICD-10, LOINC, ATC, etc.)." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/ClinicalVisit_hasCode_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/clinical-health-record/ClinicalVisit_hasCode_range> .

:hasCode
    a owl:ObjectProperty ;
    rdfs:label "Has Code" ;
    rdfs:comment "Links a Medical Procedure instance to its terminology code (SNOMED CT, ICD-10, LOINC, ATC, etc.)." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/MedicalProcedure_hasCode_domain> ;
    rdfs:range [ owl:unionOf (:Code <http://snomed.info/id/71388002>) ] .

:hasCode
    a owl:ObjectProperty ;
    rdfs:label "Has Code" ;
    rdfs:comment "Links a Measurement instance to its terminology code (SNOMED CT, ICD-10, LOINC, ATC, etc.)." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/Measurement_hasCode_domain> ;
    rdfs:range [ owl:unionOf (:Code <http://snomed.info/id/363787002>) ] .

:hasCode
    a owl:ObjectProperty ;
    rdfs:label "Has Code" ;
    rdfs:comment "Links a Medication Administration instance to its terminology code (SNOMED CT, ICD-10, LOINC, ATC, etc.)." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/MedicationAdministration_hasCode_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/clinical-health-record/MedicationAdministration_hasCode_range> .

:hasCode
    a owl:ObjectProperty ;
    rdfs:label "Has Code" ;
    rdfs:comment "Links a Anatomical Structure instance to its terminology code (SNOMED CT, ICD-10, LOINC, ATC, etc.)." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/AnatomicalStructure_hasCode_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/clinical-health-record/AnatomicalStructure_hasCode_range> .

:hasCode
    a owl:ObjectProperty ;
    rdfs:label "Has Code" ;
    rdfs:comment "Links a Severity instance to its terminology code (SNOMED CT, ICD-10, LOINC, ATC, etc.)." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/Severity_hasCode_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/clinical-health-record/Severity_hasCode_range> .

:hasCode
    a owl:ObjectProperty ;
    rdfs:label "Has Code" ;
    rdfs:comment "Links a Pharmaceutical Product instance to its terminology code (SNOMED CT, ICD-10, LOINC, ATC, etc.)." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/PharmaceuticalProduct_hasCode_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/clinical-health-record/PharmaceuticalProduct_hasCode_range> .

:hasAdministrativeCase
    a owl:ObjectProperty ;
    rdfs:label "Has Administrative Case" ;
    rdfs:comment "Links a clinical visit to the administrative case it belongs to." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/ClinicalVisit_hasAdministrativeCase_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/clinical-health-record/ClinicalVisit_hasAdministrativeCase_range> .

:hasPatient
    a owl:ObjectProperty ;
    rdfs:label "Has Patient" ;
    rdfs:comment "Links an administrative case to the patient it concerns." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/AdministrativeCase_hasPatient_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/clinical-health-record/AdministrativeCase_hasPatient_range> .

:hasSample
    a owl:ObjectProperty ;
    rdfs:label "Has Sample" ;
    rdfs:comment "Links a measurement process to the sample it is performed on." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/MeasurementProcess_hasSample_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/clinical-health-record/MeasurementProcess_hasSample_range> .

:collectedFrom
    a owl:ObjectProperty ;
    rdfs:label "Collected From" ;
    rdfs:comment "Links a sample to the patient it was collected from." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/Sample_collectedFrom_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/clinical-health-record/Sample_collectedFrom_range> .

:hasSubstance
    a owl:ObjectProperty ;
    rdfs:label "Has Substance" ;
    rdfs:comment "Links a pharmaceutical product to its active substance." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/PharmaceuticalProduct_hasSubstance_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/clinical-health-record/PharmaceuticalProduct_hasSubstance_range> .

:prescribesDrug
    a owl:ObjectProperty ;
    rdfs:label "Prescribes Drug" ;
    rdfs:comment "Links a drug prescription to the pharmaceutical product it prescribes." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/DrugPrescription_prescribesDrug_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/clinical-health-record/DrugPrescription_prescribesDrug_range> .

:hasSubject
    a owl:ObjectProperty ;
    rdfs:label "Has Subject" ;
    rdfs:comment "Records that the drug prescription (an information object) is about its patient." ;
    rdfs:domain <https://w3id.org/sulo/schema-builder/clinical-health-record/DrugPrescription_hasSubject_domain> ;
    rdfs:range <https://w3id.org/sulo/schema-builder/clinical-health-record/DrugPrescription_hasSubject_range> .

# ── Domain / Range class expressions (OWL equivalent axioms) ──────────────

<https://w3id.org/sulo/schema-builder/clinical-health-record/ClinicalVisit_hasPatient_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :ClinicalVisit [ a owl:Restriction ; owl:onProperty sulo:hasParticipant ; owl:someValuesFrom [ a owl:Class ; owl:intersectionOf ( :SubjectOfCareRole [ a owl:Restriction ; owl:onProperty sulo:isFeatureOf ; owl:someValuesFrom :Person ] ) ] ] ) ] .

<https://w3id.org/sulo/schema-builder/clinical-health-record/ClinicalVisit_hasPatient_range>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Person [ a owl:Restriction ; owl:onProperty [ owl:inverseOf sulo:isFeatureOf ] ; owl:someValuesFrom [ a owl:Class ; owl:intersectionOf ( :SubjectOfCareRole [ a owl:Restriction ; owl:onProperty [ owl:inverseOf sulo:hasParticipant ] ; owl:someValuesFrom :ClinicalVisit ] ) ] ] ) ] .

<https://w3id.org/sulo/schema-builder/clinical-health-record/ClinicalVisit_hasCareProvider_domain>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :ClinicalVisit [ a owl:Restriction ; owl:onProperty sulo:hasParticipant ; owl:someValuesFrom [ a owl:Class ; owl:intersectionOf ( :CareProviderRole [ a owl:Restriction ; owl:onProperty sulo:isFeatureOf ; owl:someValuesFrom :Person ] ) ] ] ) ] .

<https://w3id.org/sulo/schema-builder/clinical-health-record/ClinicalVisit_hasCareProvider_range>
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( :Person [ a owl:Restriction ; owl:onProperty [ owl:inverseOf sulo:isFeatureOf ] ; owl:someValuesFrom [ a owl:Class ; owl:intersectionOf ( :CareProviderRole [ a owl:Restriction ; owl:onProperty [ owl:inverseOf sulo:hasParticipant ] ; owl:someValuesFrom :ClinicalVisit ] ) ] ] ) ] .

<https://w3id.org/sulo/schema-builder/clinical-health-record/ClinicalVisit_hasCareUnit_domain>
