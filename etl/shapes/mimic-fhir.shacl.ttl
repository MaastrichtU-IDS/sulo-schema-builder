    ] .

:PatientShape
    a sh:NodeShape, owl:Class ;
    sh:targetClass :Patient ;
    rdfs:label "Patient" .

:ResultInterpretationShape
    a sh:NodeShape, owl:Class ;
    sh:targetClass :ResultInterpretation ;
    rdfs:label "Result Interpretation" .

:RouteShape
    a sh:NodeShape, owl:Class ;
    sh:targetClass :Route ;
    rdfs:label "Route" .

:SpecimenShape
    a sh:NodeShape, owl:Class ;
